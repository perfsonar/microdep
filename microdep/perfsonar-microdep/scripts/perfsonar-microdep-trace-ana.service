[Unit]
Description=perfSONAR Microdep traceroute analysis
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=perfsonar
Group=perfsonar
ExecStart=/usr/lib/perfsonar/bin/microdep_commands/trace_event_reader.py -s -O /var/lib/logstash/microdep/trace-ana.json --pssrc https://localhost//opensearch --dbtype postgresql --geodb /etc/perfsonar/microdep/GeoLite2/GeoLite2-ASN.mmdb --topoevents
Restart=on-failure

[Install]
WantedBy=multi-user.target

