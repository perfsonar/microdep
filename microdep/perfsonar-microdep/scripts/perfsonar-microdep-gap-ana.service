[Unit]
Description=perfSONAR Microdep Gap analysis
After=network.target 

[Service]
Type=simple
User=perfsonar
Group=perfsonar
# Run analysis for both ipv4 and ipv6
ExecStart=/bin/bash -c ' \
  /usr/lib/perfsonar/bin/microdep_commands/qstream-gap-ana -minloss 5 -head -win 50 -jitter 600 -rtp 5 -owamp https://localhost/opensearch -follow -json /var/lib/logstash/microdep/gap-ana.json -topoevents & \
  /usr/lib/perfsonar/bin/microdep_commands/qstream-gap-ana -minloss 5 -head -win 50 -jitter 600 -rtp 5 -owamp https://localhost/opensearch -follow -json /var/lib/logstash/microdep/gap-ana-6.json -topoevents -6 & \
  wait \
'
Restart=on-failure

[Install]
WantedBy=multi-user.target


