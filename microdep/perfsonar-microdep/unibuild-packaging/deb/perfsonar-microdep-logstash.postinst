#!/bin/sh
# postinst script for perfsonar-microdep-logstash
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package

case "$1" in
    configure)
	# Ensure perfsonar user exists
	groupadd -r perfsonar 2> /dev/null || true
	useradd -g perfsonar -r -s /sbin/nologin -c "perfSONAR User" -d /tmp perfsonar 2> /dev/null || true

	# Fix permissions
	# The pipeline files belong to root: Logstash only reads them. Earlier
	# versions of this script handed the folder to perfsonar, and dpkg leaves
	# the owner of an existing folder alone, so it is set back here.
	chown -R root:root /usr/lib/perfsonar/logstash/microdep_pipeline
	# The analysers run as perfsonar and write their output here
	chown perfsonar:perfsonar /var/lib/logstash/microdep/

	# Add Microdep to Opensearch setup (including Logstash) 
	/usr/lib/perfsonar/bin/microdep_commands/opensearch_config_microdep.sh || true

	# Archive spec for the analysers' results. It holds the archive's key, so it is made
	# again each time; ucf asks before replacing a spec edited here (#320).
	SPEC=/etc/perfsonar/microdep/microdep-ana-archive.json
	if [ -f $SPEC ] && [ ! -s $SPEC ]; then
	    rm -f $SPEC    # an empty spec left by an earlier version
	fi
	if [ ! -e $SPEC ] || [ -e /etc/perfsonar/logstash/proxy_auth.json ]; then
	    OLD=$(cat $SPEC 2>/dev/null | cksum)
	    NEW=$(mktemp -t microdep-ana-archive.json.XXXXXX)
	    if /usr/lib/perfsonar/bin/microdep_commands/psconfig_archive_ana.sh > $NEW; then
	        ( umask 077; ucf $NEW $SPEC )
	        ucfr perfsonar-microdep-logstash $SPEC
	    fi
	    rm -f $NEW
	    if [ -f $SPEC ] && [ "$(cat $SPEC | cksum)" != "$OLD" ]; then
	        # the analysers read the spec when they start
	        systemctl try-restart perfsonar-microdep-gap-ana.service perfsonar-microdep-trace-ana.service || true
	    fi
	fi
	# Readable by root and by the analysers (they run as perfsonar), and by nobody else
	for f in $SPEC $SPEC.ucf-dist $SPEC.ucf-old $SPEC.ucf-new; do
	    if [ -f $f ]; then
	        chown root:perfsonar $f
	        chmod 0640 $f
	    fi
	done
	
	# Enable apache config
        if [ -e /usr/share/apache2/apache2-maintscript-helper ]; then
            . /usr/share/apache2/apache2-maintscript-helper

            apache2_invoke enconf apache-microdep-ana
        else
	    a2enconf apache-microdep-ana
	    systemctl reload apache2.service || true
	fi
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
