[Unit]
Description=perfSONAR Microdep Gap analysis
After=network.target 

[Service]
Type=simple
User=perfsonar
Group=perfsonar
# Run analysis for both ipv4 and ipv6
# If either of the two ends, the unit fails and systemd starts both again.
# (A plain "wait" returned success once both were gone, and went on waiting
# while one was, so an analyser that stopped stayed stopped.)
ExecStart=/bin/bash -c ' \
  /usr/lib/perfsonar/bin/microdep_commands/qstream-gap-ana -conf /etc/perfsonar/microdep/microdep-gap-ana.yml & \
  /usr/lib/perfsonar/bin/microdep_commands/qstream-gap-ana -conf /etc/perfsonar/microdep/microdep-gap-ana.yml -ipv6 & \
  wait -n; exit 1 \
'
Restart=on-failure
RestartSec=30
# The analysis handles what arrives over the network, so it gets no more of the
# host than it needs: no way to gain privileges, a read-only file system, no
# home directories, devices or kernel settings, and a /tmp of its own.
# Output to files works in /var/lib/logstash/microdep. For another folder, add
# it in a drop-in ("systemctl edit" on this unit):
#   [Service]
#   ReadWritePaths=/the/folder
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
# (/run stays writable under the three settings further down that set up /proc
# and /sys for the unit, so it is named here)
ReadOnlyPaths=/run
ReadWritePaths=-/var/lib/logstash/microdep
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target


