#!/bin/sh
# prerm script for perfsonar-psconfig-publisher
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <prerm> `remove'
#        * <old-prerm> `upgrade' <new-version>
#        * <new-prerm> `failed-upgrade' <old-version>
#        * <conflictor's-prerm> `remove' `in-favour' <package> <new-version>
#        * <deconfigured's-prerm> `deconfigure' `in-favour'
#          <package-being-installed> <version> `removing'
#          <conflicting-package> <version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package

case "$1" in
    remove|deconfigure)

	# Remove Microdep from Opensearch setup (including Logstash) 
	/usr/lib/perfsonar/bin/microdep_commands/opensearch_config_microdep.sh -r config || true
	
	# Clean up db access
	if [ -f /var/lib/pgsql/data/pg_hba.conf ]; then
	    /usr/lib/perfsonar/bin/microdep_commands/fix-pgsql-access.sh -ri /var/lib/pgsql/data/pg_hba.conf
	    systemctl reload postgresql.service
	fi

	# Disable apache config
        if [ -e /usr/share/apache2/apache2-maintscript-helper ]; then
            . /usr/share/apache2/apache2-maintscript-helper

            apache2_invoke disconf apache-microdep-map
        else
	    a2disconf apache-microdep-map
	    systemctl reload apache2.service || true
	fi
    ;;

    upgrade|failed-upgrade)
    ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
